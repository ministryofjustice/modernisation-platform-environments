Host dev*-nomis* qa*-nomis* rel*-nomis* nomis-db19c-1-a
   ProxyCommand sh -c "aws ssm start-session --target $(aws ec2 describe-instances --no-cli-pager --filters "Name=instance-state-name,Values=running" "Name=tag:Name,Values=%h" --query 'Reservations[0].Instances[0].InstanceId' --profile nomis-development) --document-name AWS-StartSSHSession --parameters 'portNumber=%p' --profile nomis-development"
   HostKeyAlgorithms +ssh-rsa
   PubkeyAcceptedAlgorithms +ssh-rsa   
   StrictHostKeyChecking no
   User ec2-user
   IdentityFile ~/.ssh/nomis-development/ec2-user

# Connect to RHEL6 via jump, e.g. ssh ec2-user@10.26.x.y -AJ ssm-jump-nomis-development -o HostKeyAlgorithms=+ssh-rsa
Host ssm-jump-nomis-development
   HostName dev-nomis-db-1-a
   ProxyCommand sh -c "aws ssm start-session --target $(aws ec2 describe-instances --no-cli-pager --filters "Name=instance-state-name,Values=running" "Name=tag:Name,Values=%h" --query 'Reservations[0].Instances[0].InstanceId' --profile nomis-development) --document-name AWS-StartSSHSession --parameters 'portNumber=%p' --profile nomis-development"
   StrictHostKeyChecking no
   User ec2-user
   IdentityFile ~/.ssh/nomis-development/ec2-user   
