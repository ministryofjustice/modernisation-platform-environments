Host preprod-nomis*
   ProxyCommand sh -c "aws ssm start-session --target $(aws ec2 describe-instances --no-cli-pager --filters "Name=instance-state-name,Values=running" "Name=tag:Name,Values=%h" --query 'Reservations[0].Instances[0].InstanceId' --profile nomis-preproduction) --document-name AWS-StartSSHSession --parameters 'portNumber=%p' --profile nomis-preproduction"
   HostKeyAlgorithms +ssh-rsa
   PubkeyAcceptedAlgorithms +ssh-rsa
   StrictHostKeyChecking no
   User ec2-user
   IdentityFile ~/.ssh/nomis-preproduction/ec2-user

# Connect to RHEL6 via jump, e.g. ssh ec2-user@10.27.x.y -AJ ssm-jump-nomis-preproduction -o HostKeyAlgorithms=+ssh-rsa
Host ssm-jump-nomis-preproduction
   HostName preprod-nomis-db-1-b
   ProxyCommand sh -c "aws ssm start-session --target $(aws ec2 describe-instances --no-cli-pager --filters "Name=instance-state-name,Values=running" "Name=tag:Name,Values=%h" --query 'Reservations[0].Instances[0].InstanceId' --profile nomis-preproduction) --document-name AWS-StartSSHSession --parameters 'portNumber=%p' --profile nomis-preproduction"
   StrictHostKeyChecking no
   User ec2-user
   IdentityFile ~/.ssh/nomis-preproduction/ec2-user
