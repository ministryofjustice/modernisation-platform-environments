Host prod-nomis*
   ProxyCommand sh -c "aws ssm start-session --target $(aws ec2 describe-instances --no-cli-pager --filters "Name=instance-state-name,Values=running" "Name=tag:Name,Values=%h" --query 'Reservations[0].Instances[0].InstanceId' --profile nomis-production) --document-name AWS-StartSSHSession --parameters 'portNumber=%p' --profile nomis-production"
   HostKeyAlgorithms +ssh-rsa
   PubkeyAcceptedAlgorithms +ssh-rsa
   StrictHostKeyChecking no
   User ec2-user
   IdentityFile ~/.ssh/nomis-production/ec2-user

# Connect to RHEL6 via jump, e.g. ssh ec2-user@10.26.x.y -AJ ssm-jump-nomis-production -o HostKeyAlgorithms=+ssh-rsa
Host ssm-jump-nomis-production
   HostName prod-nomis-db-2-b
   ProxyCommand sh -c "aws ssm start-session --target $(aws ec2 describe-instances --no-cli-pager --filters "Name=instance-state-name,Values=running" "Name=tag:Name,Values=%h" --query 'Reservations[0].Instances[0].InstanceId' --profile nomis-production) --document-name AWS-StartSSHSession --parameters 'portNumber=%p' --profile nomis-production"
   StrictHostKeyChecking no
   User ec2-user
   IdentityFile ~/.ssh/nomis-production/ec2-user
