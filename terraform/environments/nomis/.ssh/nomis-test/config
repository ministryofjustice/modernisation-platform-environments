Host t1-nomis* t2-nomis* t3-nomis*
   ProxyCommand sh -c "aws ssm start-session --target $(aws ec2 describe-instances --no-cli-pager --filters "Name=instance-state-name,Values=running" "Name=tag:Name,Values=%h" --query 'Reservations[0].Instances[0].InstanceId' --profile nomis-test) --document-name AWS-StartSSHSession --parameters 'portNumber=%p' --profile nomis-test"
   HostKeyAlgorithms +ssh-rsa
   PubkeyAcceptedAlgorithms +ssh-rsa
   StrictHostKeyChecking no
   User ec2-user
   IdentityFile ~/.ssh/nomis-test/ec2-user

# Connect to RHEL6 via jump, e.g. ssh ec2-user@10.26.x.y -AJ ssm-jump-nomis-test -o HostKeyAlgorithms=+ssh-rsa
Host ssm-jump-nomis-test
   HostName t1-nomis-db-1-b
   ProxyCommand sh -c "aws ssm start-session --target $(aws ec2 describe-instances --no-cli-pager --filters "Name=instance-state-name,Values=running" "Name=tag:Name,Values=%h" --query 'Reservations[0].Instances[0].InstanceId' --profile nomis-test) --document-name AWS-StartSSHSession --parameters 'portNumber=%p' --profile nomis-test"
   StrictHostKeyChecking no
   User ec2-user
   IdentityFile ~/.ssh/nomis-test/ec2-user   
