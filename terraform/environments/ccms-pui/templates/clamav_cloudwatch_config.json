{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/clamd.scan",
            "log_group_name": "${clamav_log_group_name}",
            "log_stream_name": "{instance_id}"
          }
        ]
      }
    }
  },
  "metrics": {
    "append_dimensions": {
      "InstanceId": "$${aws:InstanceId}"
    },
    "namespace": "Custom/ClamAV",
    "metrics_collected": {
      "procstat": [
        {
          "exe": "clamd",
          "measurement": ["pid_count"],
          "metrics_collection_interval": 60
        }
      ]
    }
  }
}
