Host delius-mis-prod-bcs-* delius-mis-prod-bps-* delius-mis-prod-bws-*
   ProxyCommand sh -c "aws ssm start-session --target $(aws ec2 describe-instances --no-cli-pager --filters "Name=instance-state-name,Values=running" "Name=tag:Name,Values=%h" --query 'Reservations[0].Instances[0].InstanceId' --profile delius-mis-production) --document-name AWS-StartSSHSession --parameters 'portNumber=%p' --profile delius-mis-production"
   StrictHostKeyChecking no
   User ec2-user
   IdentityFile ~/.ssh/delius-mis-production/ec2-user
