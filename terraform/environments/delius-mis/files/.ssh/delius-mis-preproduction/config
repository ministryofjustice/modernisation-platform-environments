Host delius-mis-stage-bcs-* delius-mis-stage-bps-* delius-mis-stage-bws-* delius-mis-preprod-bcs-* delius-mis-preprod-bps-* delius-mis-preprod-bws-*
   ProxyCommand sh -c "aws ssm start-session --target $(aws ec2 describe-instances --no-cli-pager --filters "Name=instance-state-name,Values=running" "Name=tag:Name,Values=%h" --query 'Reservations[0].Instances[0].InstanceId' --profile delius-mis-preproduction) --document-name AWS-StartSSHSession --parameters 'portNumber=%p' --profile delius-mis-preproduction"
   StrictHostKeyChecking no
   User ec2-user
   IdentityFile ~/.ssh/delius-mis-preproduction/ec2-user
