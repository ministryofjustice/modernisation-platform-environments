      "type": "metric",
      "x": 0,
      "y": 34,
      "width": 6,
      "height": 6,
      "properties": {
        "metrics": [
          [
            {
              "expression": "(m1/1048576)/PERIOD(m1)",
              "label": "Expression1",
              "id": "e1",
              "visible": false,
              "region": "eu-west-2"
            }
          ],
          [
            {
              "expression": "m2/1048576",
              "label": "Expression2",
              "id": "e2",
              "visible": false,
              "region": "eu-west-2"
            }
          ],
          [
            {
              "expression": "e2-e1",
              "label": "Expression3",
              "id": "e3",
              "visible": false,
              "region": "eu-west-2"
            }
          ],
          [
            {
              "expression": "((e1)*100)/(e2)",
              "label": "Throughput utilization (%)",
              "id": "e4",
              "region": "eu-west-2"
            }
          ],
          [
            "AWS/EFS",
            "MeteredIOBytes",
            "FileSystemId",
            "${efs_id}",
            {
              "id": "m1",
              "period": 60,
              "stat": "Sum",
              "visible": false,
              "region": "eu-west-2"
            }
          ],
          [
            ".",
            "PermittedThroughput",
            ".",
            ".",
            {
              "id": "m2",
              "period": 60,
              "stat": "Average",
              "visible": false,
              "region": "eu-west-2"
            }
          ]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "eu-west-2",
        "period": 60,
        "title": "Throughput utilization (%)",
        "annotations": {
          "horizontal": [
            {
              "visible": true,
              "color": "#d13212",
              "label": "Utilization warning",
              "value": 75,
              "fill": "above",
              "yAxis": "left"
            }
          ]
        },
        "yAxis": {
          "left": {
            "max": 100
          }
        }
      }
    },
