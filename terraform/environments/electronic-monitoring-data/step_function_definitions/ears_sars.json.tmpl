{
  "StartAt": "EarsSars",
  "States": {
    "EarsSars": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$.Payload",
      "Parameters": {
        "FunctionName": "${ears_sars_request}",
        "Payload": {
          "resource": "/request/",
          "path": "/request/",
          "httpMethod": "POST",
          "headers": {
            "Content-Type": "application/json"
          },
          "multiValueHeaders": {},
          "queryStringParameters": null,
          "requestContext": {
            "resourcePath": "/request/",
            "httpMethod": "POST",
            "path": "/request/",
            "identity": {
              "sourceIp": "127.0.0.1"
            }
          },
          "isBase64Encoded": false,
          "body.$": "States.JsonToString($)"
        },
      "Retry": [
          {
            "ErrorEquals": ["Lambda.AWSLambdaException"],
            "IntervalSeconds": 2,
            "BackoffRate": 2,
            "MaxAttempts": 2
          }
        ],
      }
      "Next": "WriteToSharepoint"
    },
    "WriteToSharepoint": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$.Payload",
      "Parameters": {
        "FunctionName": "${write_to_sharepoint}",
        "Payload.$": "$"
      },
      "Retry": [
          {
            "ErrorEquals": ["Lambda.AWSLambdaException"],
            "IntervalSeconds": 2,
            "BackoffRate": 2,
            "MaxAttempts": 2
          }
        ],
      "End": true
    }
  }
}
