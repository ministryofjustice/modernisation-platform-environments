{
  "StartAt": "%{ if planner_function_name != "" && reconciliation_consumer != "" }SelectInputMode%{ else }ProcessDates%{ endif }",
  "States": {
%{ if planner_function_name != "" && reconciliation_consumer != "" }
    "SelectInputMode": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.filter_dates",
          "IsPresent": true,
          "Next": "ProcessDates"
        },
        {
          "Variable": "$.mode",
          "StringEquals": "rolling",
          "Next": "DiscoverRolling"
        },
        {
          "Variable": "$.mode",
          "StringEquals": "rolling_recovery",
          "Next": "DiscoverRollingRecovery"
        },
%{ if reconciliation_consumer == "AC" || reconciliation_consumer == "EMDI" }
        {
          "Variable": "$.mode",
          "StringEquals": "range",
          "Next": "StartHistoricalRange"
        },
        {
          "Variable": "$.mode",
          "StringEquals": "full",
          "Next": "StartHistoricalFull"
        },
%{ endif }
        {
          "Variable": "$.mode",
          "IsPresent": true,
          "Next": "UnsupportedInputMode"
        }
      ],
      "Default": "DiscoverRolling"
    },
    "DiscoverRolling": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "discover_rolling",
          "consumer": "${reconciliation_consumer}",
          "mode": "rolling",
          "execution_id.$": "$$.Execution.Id",
          "state_machine_arn.$": "$$.StateMachine.Id"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "CheckRollingDiscovery"
    },
    "DiscoverRollingContinuation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "discover_rolling",
          "consumer": "${reconciliation_consumer}",
          "mode": "rolling",
          "execution_id.$": "$$.Execution.Id",
          "state_machine_arn.$": "$$.StateMachine.Id",
          "iteration.$": "$.iteration",
          "position_start_utc.$": "$.position_start_utc",
          "activation_start_utc.$": "$.activation_start_utc"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "CheckRollingDiscovery"
    },
    "DiscoverRollingRecovery": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "discover_rolling",
          "consumer": "${reconciliation_consumer}",
          "mode": "rolling_recovery",
          "execution_id.$": "$$.Execution.Id",
          "state_machine_arn.$": "$$.StateMachine.Id",
          "recovery_episode_id.$": "$.recovery_episode_id",
          "lease_token.$": "$.lease_token"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "CheckRollingDiscovery"
    },
    "DiscoverRollingRecoveryContinuation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "discover_rolling",
          "consumer": "${reconciliation_consumer}",
          "mode": "rolling_recovery",
          "execution_id.$": "$$.Execution.Id",
          "state_machine_arn.$": "$$.StateMachine.Id",
          "recovery_episode_id.$": "$.episode_id",
          "iteration.$": "$.iteration"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "CheckRollingDiscovery"
    },
    "CheckRollingDiscovery": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.status",
          "StringEquals": "clean",
          "Next": "PlanningComplete"
        },
        {
          "Variable": "$.status",
          "StringEquals": "review_required",
          "Next": "PlanningComplete"
        },
        {
          "Variable": "$.status",
          "StringEquals": "recovery_in_progress",
          "Next": "PlanningComplete"
        },
        {
          "Variable": "$.status",
          "StringEquals": "recovery_complete",
          "Next": "RollingComplete"
        },
        {
          "Variable": "$.status",
          "StringEquals": "planning",
          "Next": "PlanRolling"
        }
      ],
      "Default": "UnexpectedPlanningResult"
    },
    "PlanRolling": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "plan_rolling",
          "consumer": "${reconciliation_consumer}",
          "execution_id.$": "$.execution_id"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "CheckRollingPlanning"
    },
    "CheckRollingPlanning": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.status",
          "StringEquals": "planning",
          "Next": "WaitBeforeRollingPlanning"
        },
        {
          "Variable": "$.status",
          "StringEquals": "replay_ready",
          "Next": "PreparePlannedDates"
        },
        {
          "Variable": "$.status",
          "StringEquals": "iteration_clean",
          "Next": "CheckEmptyRollingPlan"
        }
      ],
      "Default": "UnexpectedPlanningResult"
    },
    "WaitBeforeRollingPlanning": {
      "Type": "Wait",
      "Seconds": 1,
      "Next": "PlanRolling"
    },
    "CheckEmptyRollingPlan": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.recovery_mode",
          "BooleanEquals": true,
          "Next": "DiscoverRollingRecoveryContinuation"
        }
      ],
      "Default": "DiscoverRollingContinuation"
    },
    "PreparePlannedDates": {
      "Type": "Pass",
      "Parameters": {
        "mode": "rolling",
        "consumer": "${reconciliation_consumer}",
        "execution_id.$": "$.execution_id",
        "thread_id.$": "$.thread_id",
        "episode_id.$": "$.episode_id",
        "recovery_mode.$": "$.recovery_mode",
        "iteration.$": "$.iteration",
        "position_start_utc.$": "$.position_start_utc",
        "activation_start_utc.$": "$.activation_start_utc",
        "filter_dates.$": "$.candidates"
      },
      "Next": "ProcessDates"
    },
    "PlanningComplete": {
      "Type": "Succeed"
    },
    "UnexpectedPlanningResult": {
      "Type": "Fail",
      "Error": "UnexpectedReconciliationPlanningResult",
      "Cause": "The planner returned an unexpected rolling reconciliation status."
    },
    "UnsupportedInputMode": {
      "Type": "Fail",
      "Error": "UnsupportedReconciliationMode",
      "Cause": "The reconciliation mode is not supported for this consumer."
    },
%{ if reconciliation_consumer == "AC" || reconciliation_consumer == "EMDI" }
    "StartHistoricalRange": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "start_historical",
          "consumer": "${reconciliation_consumer}",
          "mode": "range",
          "start_date.$": "$.start_date",
          "end_date.$": "$.end_date"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "CheckHistoricalStart"
    },
    "StartHistoricalFull": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "start_historical",
          "consumer": "${reconciliation_consumer}",
          "mode": "full"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "CheckHistoricalStart"
    },
    "CheckHistoricalStart": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.status",
          "StringEquals": "planning",
          "Next": "PlanHistorical"
        },
        {
          "Variable": "$.status",
          "StringEquals": "completed",
          "Next": "HistoricalComplete"
        }
      ],
      "Default": "UnexpectedHistoricalPlanningResult"
    },
    "PlanHistorical": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "plan_historical",
          "consumer": "${reconciliation_consumer}",
          "execution_id.$": "$.execution_id"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "CheckHistoricalPlanning"
    },
    "CheckHistoricalPlanning": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.status",
          "StringEquals": "planning",
          "Next": "WaitBeforeHistoricalPlanning"
        },
        {
          "Variable": "$.status",
          "StringEquals": "replay_ready",
          "Next": "NextHistoricalChunk"
        },
        {
          "Variable": "$.status",
          "StringEquals": "approval_required",
          "Next": "WaitForHistoricalApproval"
        }
      ],
      "Default": "UnexpectedHistoricalPlanningResult"
    },
    "WaitBeforeHistoricalPlanning": {
      "Type": "Wait",
      "Seconds": 1,
      "Next": "PlanHistorical"
    },
    "WaitForHistoricalApproval": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "park_historical_approval",
          "consumer": "${reconciliation_consumer}",
          "execution_id.$": "$.execution_id",
          "plan_id.$": "$.plan_id",
          "task_token.$": "$$.Task.Token"
        }
      },
      "ResultPath": "$.approval",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "RecordHistoricalApproval"
    },
    "RecordHistoricalApproval": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "record_historical_approval",
          "consumer": "${reconciliation_consumer}",
          "execution_id.$": "$.execution_id",
          "plan_id.$": "$.plan_id",
          "decision.$": "$.approval.decision"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "CheckHistoricalApproval"
    },
    "CheckHistoricalApproval": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.status",
          "StringEquals": "replay_ready",
          "Next": "NextHistoricalChunk"
        },
        {
          "Variable": "$.status",
          "StringEquals": "rejected",
          "Next": "HistoricalRejected"
        }
      ],
      "Default": "UnexpectedHistoricalApprovalResult"
    },
    "NextHistoricalChunk": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "next_historical_chunk",
          "consumer": "${reconciliation_consumer}",
          "execution_id.$": "$.execution_id"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "CheckHistoricalChunk"
    },
    "CheckHistoricalChunk": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.status",
          "StringEquals": "chunk_ready",
          "Next": "ReplayHistoricalPosition"
        },
        {
          "Variable": "$.status",
          "StringEquals": "complete",
          "Next": "CompleteHistorical"
        },
        {
          "Variable": "$.status",
          "StringEquals": "approval_required",
          "Next": "WaitForHistoricalApproval"
        }
      ],
      "Default": "UnexpectedHistoricalReplayResult"
    },
    "ReplayHistoricalPosition": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${merge_function_name}",
        "Payload.$": "$.replay_input"
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 5,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "VerifyHistoricalChunk"
    },
    "VerifyHistoricalChunk": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "verify_historical_chunk",
          "consumer": "${reconciliation_consumer}",
          "execution_id.$": "$.execution_id",
          "chunk_index.$": "$.chunk_index"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "CheckHistoricalVerification"
    },
    "CheckHistoricalVerification": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.status",
          "StringEquals": "verified",
          "Next": "CheckpointHistoricalChunk"
        },
        {
          "Variable": "$.status",
          "StringEquals": "verification_failed",
          "Next": "HistoricalVerificationFailed"
        }
      ],
      "Default": "UnexpectedHistoricalVerificationResult"
    },
    "CheckpointHistoricalChunk": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "checkpoint_historical",
          "consumer": "${reconciliation_consumer}",
          "execution_id.$": "$.execution_id",
          "chunk_index.$": "$.chunk_index",
          "verification_status.$": "$.status",
          "positions_recovered.$": "$.positions_recovered",
          "data_scanned_in_bytes.$": "$.data_scanned_in_bytes",
          "period.$": "$.period"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "NextHistoricalChunk"
    },
    "CompleteHistorical": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "complete_historical",
          "consumer": "${reconciliation_consumer}",
          "execution_id.$": "$.execution_id"
        }
      },
      "OutputPath": "$.Payload",
      "Next": "HistoricalComplete"
    },
    "HistoricalComplete": {
      "Type": "Succeed"
    },
    "HistoricalRejected": {
      "Type": "Succeed"
    },
    "HistoricalVerificationFailed": {
      "Type": "Fail",
      "Error": "HistoricalReconciliationVerificationFailed",
      "Cause": "Eligible positions remain after historical replay."
    },
    "UnexpectedHistoricalPlanningResult": {
      "Type": "Fail",
      "Error": "UnexpectedHistoricalPlanningResult",
      "Cause": "The planner returned an unexpected historical planning status."
    },
    "UnexpectedHistoricalApprovalResult": {
      "Type": "Fail",
      "Error": "UnexpectedHistoricalApprovalResult",
      "Cause": "The historical approval callback returned an unexpected result."
    },
    "UnexpectedHistoricalReplayResult": {
      "Type": "Fail",
      "Error": "UnexpectedHistoricalReplayResult",
      "Cause": "The planner returned an unexpected historical replay status."
    },
    "UnexpectedHistoricalVerificationResult": {
      "Type": "Fail",
      "Error": "UnexpectedHistoricalVerificationResult",
      "Cause": "The planner returned an unexpected historical verification status."
    },
%{ endif }
%{ endif }
    "ProcessDates": {
      "Type": "Map",
      "ItemsPath": "$.filter_dates",
      "MaxConcurrency": 1,
      "ResultPath": "$.date_results",
      "ItemSelector": {
        "filter_date.$": "$$.Map.Item.Value",
        "input.$": "$"
      },
      "Iterator": {
        "StartAt": "%{ if planner_function_name != "" && reconciliation_consumer != "" }SelectDateInput%{ else }MergeInto${table_name}%{ endif }",
        "States": {
%{ if planner_function_name != "" && reconciliation_consumer != "" }
          "SelectDateInput": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.filter_date.replay_input",
                "IsPresent": true,
                "Next": "MergePlanned${table_name}"
              }
            ],
            "Default": "MergeInto${table_name}"
          },
          "MergePlanned${table_name}": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "ResultPath": "$.merge_result",
            "Parameters": {
              "FunctionName": "${merge_function_name}",
              "Payload.$": "$.filter_date.replay_input"
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "IntervalSeconds": 2,
                "BackoffRate": 2,
                "MaxAttempts": 2
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "MarkPlannedFailed"
              }
            ],
            "Next": "VerifyRollingCandidate"
          },
          "VerifyRollingCandidate": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "ResultPath": "$.verification",
            "Parameters": {
              "FunctionName": "${planner_function_name}",
              "Payload": {
                "action": "verify_rolling",
                "candidate.$": "$.filter_date"
              }
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "BackoffRate": 2,
                "MaxAttempts": 3
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "MarkPlannedFailed"
              }
            ],
            "Next": "CheckRollingVerification"
          },
          "CheckRollingVerification": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.verification.Payload.status",
                "StringEquals": "verified",
                "Next": "MarkPlannedSucceeded"
              },
              {
                "Variable": "$.verification.Payload.status",
                "StringEquals": "verification_failed",
                "Next": "RollingVerificationFailed"
              }
            ],
            "Default": "UnexpectedRollingVerificationResult"
          },
          "MarkPlannedSucceeded": {
            "Type": "Pass",
            "Parameters": {
              "status": "SUCCEEDED",
              "result.$": "$.verification.Payload"
            },
            "End": true
          },
          "MarkPlannedFailed": {
            "Type": "Pass",
            "Parameters": {
              "status": "FAILED",
              "error.$": "$.error"
            },
            "End": true
          },
          "RollingVerificationFailed": {
            "Type": "Pass",
            "Parameters": {
              "status": "FAILED",
              "error": {
                "Error": "RollingReconciliationVerificationFailed",
                "Cause": "Stale positions remain after rolling replay."
              },
              "result.$": "$.verification.Payload"
            },
            "End": true
          },
          "UnexpectedRollingVerificationResult": {
            "Type": "Pass",
            "Parameters": {
              "status": "FAILED",
              "error": {
                "Error": "UnexpectedRollingVerificationResult",
                "Cause": "The planner returned an unexpected rolling verification status."
              }
            },
            "End": true
          },
%{ endif }
          "MergeInto${table_name}": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "ResultPath": "$.merge_result",
            "Parameters": {
              "FunctionName": "${merge_function_name}",
              "Payload": {
                "resource": "/request/",
                "path": "/request/",
                "httpMethod": "POST",
                "headers": {
                  "Content-Type": "application/json"
                },
                "multiValueHeaders": {},
                "queryStringParameters": null,
                "requestContext": {
                  "resourcePath": "/request/",
                  "httpMethod": "POST",
                  "path": "/request/",
                  "identity": {
                    "sourceIp": "127.0.0.1"
                  }
                },
                "isBase64Encoded": false,
                "body.$": "States.JsonToString($)"
              }
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "IntervalSeconds": 2,
                "BackoffRate": 2,
                "MaxAttempts": 2
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "MarkFailed"
              }
            ],
            "Next": "MarkSucceeded"
          },
          "MarkSucceeded": {
            "Type": "Pass",
            "Parameters": {
              "filter_date.$": "$.filter_date",
              "status": "SUCCEEDED",
              "result.$": "$.merge_result.Payload"
            },
            "End": true
          },
          "MarkFailed": {
            "Type": "Pass",
            "Parameters": {
              "filter_date.$": "$.filter_date",
              "status": "FAILED",
              "error.$": "$.error"
            },
            "End": true
          }
        }
      },
%{ if planner_function_name != "" && reconciliation_consumer != "" }
      "Next": "CheckProcessDatesCompletion"
%{ else }
      "End": true
%{ endif }
    }%{ if planner_function_name != "" && reconciliation_consumer != "" },
    "CheckProcessDatesCompletion": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.mode",
          "StringEquals": "rolling",
          "Next": "CompleteRolling"
        }
      ],
      "Default": "MergeComplete"
    },
    "CompleteRolling": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "complete_rolling",
          "consumer": "${reconciliation_consumer}",
          "execution_id.$": "$.execution_id",
          "thread_id.$": "$.thread_id",
          "episode_id.$": "$.episode_id",
          "results.$": "$.date_results"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "CheckRollingCompletion"
    },
    "CheckRollingCompletion": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.status",
          "StringEquals": "continue_rolling",
          "Next": "DiscoverRollingContinuation"
        },
        {
          "Variable": "$.status",
          "StringEquals": "continue_recovery",
          "Next": "DiscoverRollingRecoveryContinuation"
        },
        {
          "Variable": "$.status",
          "StringEquals": "continue_execution",
          "Next": "StartRecoveryContinuation"
        },
        {
          "Variable": "$.status",
          "StringEquals": "completed",
          "Next": "RollingComplete"
        },
        {
          "Variable": "$.status",
          "StringEquals": "failed",
          "Next": "RollingFailed"
        }
      ],
      "Default": "UnexpectedRollingCompletionResult"
    },
    "StartRecoveryContinuation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution",
      "Parameters": {
        "StateMachineArn.$": "$$.StateMachine.Id",
        "Name.$": "States.UUID()",
        "Input": {
          "mode": "rolling_recovery",
          "recovery_episode_id.$": "$.episode_id",
          "lease_token.$": "$.lease_token",
          "AWS_STEP_FUNCTIONS_STARTED_BY_EXECUTION_ID.$": "$$.Execution.Id"
        }
      },
      "ResultPath": "$.continuation",
      "Next": "RollingComplete"
    },
    "RollingComplete": {
      "Type": "Succeed"
    },
    "RollingFailed": {
      "Type": "Fail",
      "Error": "RollingReconciliationFailed",
      "Cause": "One or more rolling replay work items failed."
    },
    "UnexpectedRollingCompletionResult": {
      "Type": "Fail",
      "Error": "UnexpectedRollingCompletionResult",
      "Cause": "The planner returned an unexpected rolling completion status."
    },
    "MergeComplete": {
      "Type": "Succeed"
    }
%{ endif }
  }
}
