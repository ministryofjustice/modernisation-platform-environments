{
  "StartAt": "%{ if planner_function_name != "" && reconciliation_consumer != "" }SelectInputMode%{ else }ProcessDates%{ endif }",
  "States": {
%{ if planner_function_name != "" && reconciliation_consumer != "" }
    "SelectInputMode": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.filter_dates",
          "IsPresent": true,
          "Next": "ProcessDates"
        },
        {
          "Variable": "$.mode",
          "StringEquals": "rolling",
          "Next": "DiscoverRolling"
        },
        {
          "Variable": "$.mode",
          "StringEquals": "rolling_recovery",
          "Next": "DiscoverRollingRecovery"
        },
%{ if reconciliation_consumer == "AC" || reconciliation_consumer == "EMDI" }
        {
          "Variable": "$.mode",
          "StringEquals": "range",
          "Next": "StartHistoricalRange"
        },
        {
          "Variable": "$.mode",
          "StringEquals": "full",
          "Next": "StartHistoricalFull"
        },
        {
          "Variable": "$.mode",
          "StringEquals": "historical_recovery",
          "Next": "ResumeHistoricalRecovery"
        },
%{ endif }
        {
          "Variable": "$.mode",
          "IsPresent": true,
          "Next": "UnsupportedInputMode"
        }
      ],
      "Default": "DiscoverRolling"
    },
    "DiscoverRolling": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "discover_rolling",
          "consumer": "${reconciliation_consumer}",
          "mode": "rolling",
          "execution_id.$": "$$.Execution.Id",
          "state_machine_arn.$": "$$.StateMachine.Id"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "CheckRollingDiscovery"
    },
    "DiscoverRollingContinuation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "discover_rolling",
          "consumer": "${reconciliation_consumer}",
          "mode": "rolling",
          "execution_id.$": "$$.Execution.Id",
          "state_machine_arn.$": "$$.StateMachine.Id",
          "iteration.$": "$.iteration",
          "position_start_utc.$": "$.position_start_utc",
          "activation_start_utc.$": "$.activation_start_utc"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "CheckRollingDiscovery"
    },
    "DiscoverRollingRecovery": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "discover_rolling",
          "consumer": "${reconciliation_consumer}",
          "mode": "rolling_recovery",
          "execution_id.$": "$$.Execution.Id",
          "state_machine_arn.$": "$$.StateMachine.Id",
          "recovery_episode_id.$": "$.recovery_episode_id",
          "lease_token.$": "$.lease_token"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "CheckRollingDiscovery"
    },
    "DiscoverRollingRecoveryContinuation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "discover_rolling",
          "consumer": "${reconciliation_consumer}",
          "mode": "rolling_recovery",
          "execution_id.$": "$$.Execution.Id",
          "state_machine_arn.$": "$$.StateMachine.Id",
          "recovery_episode_id.$": "$.episode_id",
          "iteration.$": "$.iteration"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "CheckRollingDiscovery"
    },
    "CheckRollingDiscovery": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.status",
          "StringEquals": "clean",
          "Next": "PlanningComplete"
        },
        {
          "Variable": "$.status",
          "StringEquals": "review_required",
          "Next": "PlanningComplete"
        },
        {
          "Variable": "$.status",
          "StringEquals": "recovery_in_progress",
          "Next": "PlanningComplete"
        },
        {
          "Variable": "$.status",
          "StringEquals": "recovery_complete",
          "Next": "RollingComplete"
        },
        {
          "Variable": "$.status",
          "StringEquals": "planning",
          "Next": "PlanRolling"
        }
      ],
      "Default": "UnexpectedPlanningResult"
    },
    "PlanRolling": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "plan_rolling",
          "consumer": "${reconciliation_consumer}",
          "execution_id.$": "$.execution_id"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "CheckRollingPlanning"
    },
    "CheckRollingPlanning": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.status",
          "StringEquals": "planning",
          "Next": "WaitBeforeRollingPlanning"
        },
        {
          "Variable": "$.status",
          "StringEquals": "replay_ready",
          "Next": "PreparePlannedDates"
        },
        {
          "Variable": "$.status",
          "StringEquals": "iteration_clean",
          "Next": "CheckEmptyRollingPlan"
        }
      ],
      "Default": "UnexpectedPlanningResult"
    },
    "WaitBeforeRollingPlanning": {
      "Type": "Wait",
      "Seconds": 1,
      "Next": "PlanRolling"
    },
    "CheckEmptyRollingPlan": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.recovery_mode",
          "BooleanEquals": true,
          "Next": "DiscoverRollingRecoveryContinuation"
        }
      ],
      "Default": "DiscoverRollingContinuation"
    },
    "PreparePlannedDates": {
      "Type": "Pass",
      "Parameters": {
        "mode": "rolling",
        "consumer": "${reconciliation_consumer}",
        "execution_id.$": "$.execution_id",
        "thread_id.$": "$.thread_id",
        "episode_id.$": "$.episode_id",
        "recovery_mode.$": "$.recovery_mode",
        "iteration.$": "$.iteration",
        "position_start_utc.$": "$.position_start_utc",
        "activation_start_utc.$": "$.activation_start_utc",
        "filter_dates.$": "$.candidates"
      },
      "Next": "ProcessDates"
    },
    "PlanningComplete": {
      "Type": "Succeed"
    },
    "UnexpectedPlanningResult": {
      "Type": "Fail",
      "Error": "UnexpectedReconciliationPlanningResult",
      "Cause": "The planner returned an unexpected rolling reconciliation status."
    },
    "UnsupportedInputMode": {
      "Type": "Fail",
      "Error": "UnsupportedReconciliationMode",
      "Cause": "The reconciliation mode is not supported for this consumer."
    },
%{ if reconciliation_consumer == "AC" || reconciliation_consumer == "EMDI" }
    "StartHistoricalRange": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "start_historical",
          "consumer": "${reconciliation_consumer}",
          "mode": "range",
          "start_date.$": "$.start_date",
          "end_date.$": "$.end_date"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "CheckHistoricalStart"
    },
    "StartHistoricalFull": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "start_historical",
          "consumer": "${reconciliation_consumer}",
          "mode": "full"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "CheckHistoricalStart"
    },
    "CheckHistoricalStart": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.status",
          "StringEquals": "planning",
          "Next": "RunHistoricalDiscovery"
        },
        {
          "Variable": "$.status",
          "StringEquals": "completed",
          "Next": "HistoricalComplete"
        }
      ],
      "Default": "UnexpectedHistoricalPlanningResult"
    },
    "RunHistoricalDiscovery": {
      "Type": "Map",
      "Label": "HistoricalDiscovery",
      "ItemReader": {
        "Resource": "arn:aws:states:::s3:getObject",
        "ReaderConfig": {
          "InputType": "JSON",
          "ItemsPointer": "/pending_scopes"
        },
        "Parameters": {
          "Bucket.$": "$.discovery_bucket",
          "Key.$": "$.discovery_plan_key"
        }
      },
      "ItemSelector": {
        "consumer": "${reconciliation_consumer}",
        "execution_id.$": "$.execution_id",
        "scope_index.$": "$$.Map.Item.Index",
        "scope.$": "$$.Map.Item.Value"
      },
      "MaxConcurrency": 5,
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "DISTRIBUTED",
          "ExecutionType": "STANDARD"
        },
        "StartAt": "InspectHistoricalDiscoveryScope",
        "States": {
          "InspectHistoricalDiscoveryScope": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${planner_function_name}",
              "Payload": {
                "action": "inspect_historical_discovery_scope",
                "consumer.$": "$.consumer",
                "execution_id.$": "$.execution_id",
                "scope_index.$": "$.scope_index",
                "scope.$": "$.scope"
              }
            },
            "OutputPath": "$.Payload",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "BackoffRate": 2,
                "MaxAttempts": 3
              }
            ],
            "End": true
          }
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "NotifyHistoricalFailure"
        }
      ],
      "Next": "AggregateHistoricalDiscovery"
    },
    "AggregateHistoricalDiscovery": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "aggregate_historical_discovery",
          "consumer": "${reconciliation_consumer}",
          "execution_id.$": "$.execution_id",
          "scope_count.$": "$.discovery_scope_count"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "NotifyHistoricalFailure"
        }
      ],
      "Next": "CheckHistoricalDiscovery"
    },
    "CheckHistoricalDiscovery": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.status",
          "StringEquals": "replay_ready",
          "Next": "PrepareHistoricalAutomaticRecovery"
        },
        {
          "Variable": "$.status",
          "StringEquals": "approval_required",
          "Next": "PrepareHistoricalApproval"
        },
        {
          "Variable": "$.status",
          "StringEquals": "completed",
          "Next": "HistoricalComplete"
        }
      ],
      "Default": "UnexpectedHistoricalPlanningResult"
    },
    "PrepareHistoricalAutomaticRecovery": {
      "Type": "Pass",
      "Parameters": {
        "execution_id.$": "$.execution_id",
        "phase": "automatic",
        "recovery_execution_index": 0
      },
      "Next": "StartHistoricalAutomaticRecovery"
    },
    "StartHistoricalAutomaticRecovery": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution",
      "Parameters": {
        "StateMachineArn.$": "$$.StateMachine.Id",
        "Name.$": "States.Format('historical-auto-{}-{}', $.execution_id, $.recovery_execution_index)",
        "Input": {
          "mode": "historical_recovery",
          "execution_id.$": "$.execution_id",
          "phase": "automatic",
          "recovery_execution_index.$": "$.recovery_execution_index",
          "AWS_STEP_FUNCTIONS_STARTED_BY_EXECUTION_ID.$": "$$.Execution.Id"
        }
      },
      "ResultPath": "$.recovery",
      "Next": "HistoricalRecoveryStarted"
    },
    "HistoricalRecoveryStarted": {
      "Type": "Succeed"
    },
    "PrepareHistoricalApproval": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "prepare_historical_approval",
          "consumer": "${reconciliation_consumer}",
          "execution_id.$": "$.execution_id",
          "plan_id.$": "$.plan_id"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "NotifyHistoricalFailure"
        }
      ],
      "Next": "HistoricalApprovalAndAutomaticRecovery"
    },
    "HistoricalApprovalAndAutomaticRecovery": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "WaitForHistoricalApproval",
          "States": {
            "WaitForHistoricalApproval": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
              "Parameters": {
                "FunctionName": "${planner_function_name}",
                "Payload": {
                  "action": "park_historical_approval",
                  "consumer": "${reconciliation_consumer}",
                  "execution_id.$": "$.execution_id",
                  "plan_id.$": "$.plan_id",
                  "task_token.$": "$$.Task.Token"
                }
              },
              "ResultPath": "$.approval",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 2,
                  "BackoffRate": 2,
                  "MaxAttempts": 3
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "HasHistoricalAutomaticScopes",
          "States": {
            "HasHistoricalAutomaticScopes": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.automatic_scope_count",
                  "NumericGreaterThan": 0,
                  "Next": "RunHistoricalAutomaticRecovery"
                }
              ],
              "Default": "NoHistoricalAutomaticRecovery"
            },
            "RunHistoricalAutomaticRecovery": {
              "Type": "Task",
              "Resource": "arn:aws:states:::states:startExecution.sync:2",
              "Parameters": {
                "StateMachineArn.$": "$$.StateMachine.Id",
                "Name.$": "States.Format('historical-auto-{}-0', $.execution_id)",
                "Input": {
                  "mode": "historical_recovery",
                  "execution_id.$": "$.execution_id",
                  "phase": "automatic",
                  "recovery_execution_index": 0,
                  "AWS_STEP_FUNCTIONS_STARTED_BY_EXECUTION_ID.$": "$$.Execution.Id"
                }
              },
              "ResultPath": "$.automatic_recovery",
              "End": true
            },
            "NoHistoricalAutomaticRecovery": {
              "Type": "Pass",
              "End": true
            }
          }
        }
      ],
      "ResultPath": "$.approval_and_recovery",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "NotifyHistoricalFailure"
        }
      ],
      "Next": "PrepareHistoricalApprovalDecision"
    },
    "PrepareHistoricalApprovalDecision": {
      "Type": "Pass",
      "Parameters": {
        "consumer": "${reconciliation_consumer}",
        "execution_id.$": "$.execution_id",
        "plan_id.$": "$.plan_id",
        "decision.$": "$.approval_and_recovery[0].approval.decision"
      },
      "Next": "RecordHistoricalApproval"
    },
    "RecordHistoricalApproval": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "record_historical_approval",
          "consumer": "${reconciliation_consumer}",
          "execution_id.$": "$.execution_id",
          "plan_id.$": "$.plan_id",
          "decision.$": "$.decision"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "NotifyHistoricalFailure"
        }
      ],
      "Next": "CheckHistoricalApproval"
    },
    "CheckHistoricalApproval": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.status",
          "StringEquals": "replay_ready",
          "Next": "PrepareHistoricalReviewRecovery"
        },
        {
          "Variable": "$.status",
          "StringEquals": "rejected",
          "Next": "HistoricalRejected"
        }
      ],
      "Default": "UnexpectedHistoricalApprovalResult"
    },
    "PrepareHistoricalReviewRecovery": {
      "Type": "Pass",
      "Parameters": {
        "execution_id.$": "$.execution_id",
        "phase": "review",
        "recovery_execution_index": 0
      },
      "Next": "StartHistoricalReviewRecovery"
    },
    "StartHistoricalReviewRecovery": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution",
      "Parameters": {
        "StateMachineArn.$": "$$.StateMachine.Id",
        "Name.$": "States.Format('historical-review-{}-{}', $.execution_id, $.recovery_execution_index)",
        "Input": {
          "mode": "historical_recovery",
          "execution_id.$": "$.execution_id",
          "phase": "review",
          "recovery_execution_index.$": "$.recovery_execution_index",
          "AWS_STEP_FUNCTIONS_STARTED_BY_EXECUTION_ID.$": "$$.Execution.Id"
        }
      },
      "ResultPath": "$.recovery",
      "Next": "HistoricalReviewRecoveryStarted"
    },
    "HistoricalReviewRecoveryStarted": {
      "Type": "Succeed"
    },
    "ResumeHistoricalRecovery": {
      "Type": "Pass",
      "Parameters": {
        "consumer": "${reconciliation_consumer}",
        "execution_id.$": "$.execution_id",
        "recovery_phase.$": "$.phase",
        "recovery_execution_index.$": "$.recovery_execution_index",
        "recovery_chunks_in_execution": 0
      },
      "Next": "NextHistoricalChunk"
    },
    "NextHistoricalChunk": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "next_historical_chunk",
          "consumer": "${reconciliation_consumer}",
          "execution_id.$": "$.execution_id",
          "phase.$": "$.recovery_phase"
        }
      },
      "ResultPath": "$.chunk_result",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "NotifyHistoricalFailure"
        }
      ],
      "Next": "CheckHistoricalChunk"
    },
    "CheckHistoricalChunk": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.chunk_result.Payload.status",
          "StringEquals": "chunk_ready",
          "Next": "ReplayHistoricalPosition"
        },
        {
          "Variable": "$.chunk_result.Payload.status",
          "StringEquals": "scope_split",
          "Next": "NextHistoricalChunk"
        },
        {
          "Variable": "$.chunk_result.Payload.status",
          "StringEquals": "scope_clean",
          "Next": "NextHistoricalChunk"
        },
        {
          "Variable": "$.chunk_result.Payload.status",
          "StringEquals": "phase_complete",
          "Next": "CheckHistoricalPhaseCompletion"
        }
      ],
      "Default": "UnexpectedHistoricalReplayResult"
    },
    "ReplayHistoricalPosition": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${merge_function_name}",
        "Payload.$": "$.chunk_result.Payload.replay_input"
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 15,
          "BackoffRate": 2,
          "MaxAttempts": 6
        },
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "NotifyHistoricalFailure"
        }
      ],
      "Next": "VerifyHistoricalChunk"
    },
    "VerifyHistoricalChunk": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "verify_historical_chunk",
          "consumer": "${reconciliation_consumer}",
          "execution_id.$": "$.execution_id",
          "phase.$": "$.recovery_phase"
        }
      },
      "ResultPath": "$.verification_result",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "NotifyHistoricalFailure"
        }
      ],
      "Next": "CheckHistoricalVerification"
    },
    "CheckHistoricalVerification": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.verification_result.Payload.status",
          "StringEquals": "verified",
          "Next": "CheckpointHistoricalChunk"
        },
        {
          "Variable": "$.verification_result.Payload.status",
          "StringEquals": "verification_failed",
          "Next": "HistoricalVerificationFailed"
        }
      ],
      "Default": "UnexpectedHistoricalVerificationResult"
    },
    "CheckpointHistoricalChunk": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "checkpoint_historical",
          "consumer": "${reconciliation_consumer}",
          "execution_id.$": "$.execution_id",
          "phase.$": "$.recovery_phase",
          "verification_status.$": "$.verification_result.Payload.status",
          "positions_recovered.$": "$.verification_result.Payload.positions_recovered",
          "data_scanned_in_bytes.$": "$.verification_result.Payload.data_scanned_in_bytes",
          "period.$": "$.verification_result.Payload.period"
        }
      },
      "ResultPath": "$.checkpoint_result",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "NotifyHistoricalFailure"
        }
      ],
      "Next": "IncrementHistoricalRecovery"
    },
    "IncrementHistoricalRecovery": {
      "Type": "Pass",
      "Parameters": {
        "consumer": "${reconciliation_consumer}",
        "execution_id.$": "$.execution_id",
        "recovery_phase.$": "$.recovery_phase",
        "recovery_execution_index.$": "$.recovery_execution_index",
        "recovery_chunks_in_execution.$": "States.MathAdd($.recovery_chunks_in_execution, 1)"
      },
      "Next": "CheckHistoricalRecoveryLimit"
    },
    "CheckHistoricalRecoveryLimit": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.recovery_chunks_in_execution",
          "NumericGreaterThanEquals": 20,
          "Next": "PrepareHistoricalRecoveryContinuation"
        }
      ],
      "Default": "NextHistoricalChunk"
    },
    "PrepareHistoricalRecoveryContinuation": {
      "Type": "Pass",
      "Parameters": {
        "execution_id.$": "$.execution_id",
        "recovery_phase.$": "$.recovery_phase",
        "recovery_execution_index.$": "States.MathAdd($.recovery_execution_index, 1)"
      },
      "Next": "StartHistoricalRecoveryContinuation"
    },
    "StartHistoricalRecoveryContinuation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Parameters": {
        "StateMachineArn.$": "$$.StateMachine.Id",
        "Name.$": "States.Format('historical-{}-{}-{}', $.recovery_phase, $.execution_id, $.recovery_execution_index)",
        "Input": {
          "mode": "historical_recovery",
          "execution_id.$": "$.execution_id",
          "phase.$": "$.recovery_phase",
          "recovery_execution_index.$": "$.recovery_execution_index",
          "AWS_STEP_FUNCTIONS_STARTED_BY_EXECUTION_ID.$": "$$.Execution.Id"
        }
      },
      "ResultPath": "$.continuation",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "NotifyHistoricalFailure"
        }
      ],
      "Next": "HistoricalRecoveryContinued"
    },
    "HistoricalRecoveryContinued": {
      "Type": "Succeed"
    },
    "CheckHistoricalPhaseCompletion": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.recovery_phase",
          "StringEquals": "automatic",
          "Next": "CheckAutomaticHistoricalCompletion"
        },
        {
          "Variable": "$.recovery_phase",
          "StringEquals": "review",
          "Next": "CompleteHistorical"
        }
      ],
      "Default": "UnexpectedHistoricalReplayResult"
    },
    "CheckAutomaticHistoricalCompletion": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.chunk_result.Payload.review_scope_count",
          "NumericGreaterThan": 0,
          "Next": "HistoricalPhaseComplete"
        }
      ],
      "Default": "CompleteHistorical"
    },
    "HistoricalPhaseComplete": {
      "Type": "Succeed"
    },
    "CompleteHistorical": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "complete_historical",
          "consumer": "${reconciliation_consumer}",
          "execution_id.$": "$.execution_id"
        }
      },
      "OutputPath": "$.Payload",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "NotifyHistoricalFailure"
        }
      ],
      "Next": "HistoricalComplete"
    },
    "HistoricalComplete": {
      "Type": "Succeed"
    },
    "HistoricalRejected": {
      "Type": "Succeed"
    },
    "HistoricalVerificationFailed": {
      "Type": "Pass",
      "Parameters": {
        "consumer": "${reconciliation_consumer}",
        "execution_id.$": "$.execution_id",
        "failure": {
          "Error": "HistoricalReconciliationVerificationFailed",
          "Cause": "Eligible positions remain after historical replay."
        }
      },
      "Next": "NotifyHistoricalFailure"
    },
    "UnexpectedHistoricalPlanningResult": {
      "Type": "Pass",
      "Parameters": {
        "consumer": "${reconciliation_consumer}",
        "execution_id.$": "$.execution_id",
        "failure": {
          "Error": "UnexpectedHistoricalPlanningResult",
          "Cause": "The planner returned an unexpected historical planning status."
        }
      },
      "Next": "NotifyHistoricalFailure"
    },
    "UnexpectedHistoricalApprovalResult": {
      "Type": "Pass",
      "Parameters": {
        "consumer": "${reconciliation_consumer}",
        "execution_id.$": "$.execution_id",
        "failure": {
          "Error": "UnexpectedHistoricalApprovalResult",
          "Cause": "The historical approval callback returned an unexpected result."
        }
      },
      "Next": "NotifyHistoricalFailure"
    },
    "UnexpectedHistoricalReplayResult": {
      "Type": "Pass",
      "Parameters": {
        "consumer": "${reconciliation_consumer}",
        "execution_id.$": "$.execution_id",
        "failure": {
          "Error": "UnexpectedHistoricalReplayResult",
          "Cause": "The planner returned an unexpected historical replay status."
        }
      },
      "Next": "NotifyHistoricalFailure"
    },
    "UnexpectedHistoricalVerificationResult": {
      "Type": "Pass",
      "Parameters": {
        "consumer": "${reconciliation_consumer}",
        "execution_id.$": "$.execution_id",
        "failure": {
          "Error": "UnexpectedHistoricalVerificationResult",
          "Cause": "The planner returned an unexpected historical verification status."
        }
      },
      "Next": "NotifyHistoricalFailure"
    },
    "NotifyHistoricalFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "fail_historical",
          "consumer": "${reconciliation_consumer}",
          "execution_id.$": "$.execution_id",
          "failure.$": "$.failure"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "HistoricalFailed"
    },
    "HistoricalFailed": {
      "Type": "Fail",
      "Error": "HistoricalReconciliationFailed",
      "Cause": "Historical reconciliation failed. See the Amazon Q notification for details."
    },
%{ endif }
%{ endif }
    "ProcessDates": {
      "Type": "Map",
      "ItemsPath": "$.filter_dates",
      "MaxConcurrency": 1,
      "ResultPath": "$.date_results",
      "ItemSelector": {
        "filter_date.$": "$$.Map.Item.Value"
      },
      "Iterator": {
        "StartAt": "%{ if planner_function_name != "" && reconciliation_consumer != "" }SelectDateInput%{ else }MergeInto${table_name}%{ endif }",
        "States": {
%{ if planner_function_name != "" && reconciliation_consumer != "" }
          "SelectDateInput": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.filter_date.replay_input",
                "IsPresent": true,
                "Next": "MergePlanned${table_name}"
              }
            ],
            "Default": "MergeInto${table_name}"
          },
          "MergePlanned${table_name}": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "ResultPath": "$.merge_result",
            "Parameters": {
              "FunctionName": "${merge_function_name}",
              "Payload.$": "$.filter_date.replay_input"
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 15,
                "BackoffRate": 2,
                "MaxAttempts": 6
              },
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "IntervalSeconds": 2,
                "BackoffRate": 2,
                "MaxAttempts": 2
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "MarkPlannedFailed"
              }
            ],
            "Next": "VerifyRollingCandidate"
          },
          "VerifyRollingCandidate": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "ResultPath": "$.verification",
            "Parameters": {
              "FunctionName": "${planner_function_name}",
              "Payload": {
                "action": "verify_rolling",
                "candidate.$": "$.filter_date"
              }
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "BackoffRate": 2,
                "MaxAttempts": 3
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "MarkPlannedFailed"
              }
            ],
            "Next": "CheckRollingVerification"
          },
          "CheckRollingVerification": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.verification.Payload.status",
                "StringEquals": "verified",
                "Next": "MarkPlannedSucceeded"
              },
              {
                "Variable": "$.verification.Payload.status",
                "StringEquals": "verification_failed",
                "Next": "RollingVerificationFailed"
              }
            ],
            "Default": "UnexpectedRollingVerificationResult"
          },
          "MarkPlannedSucceeded": {
            "Type": "Pass",
            "Parameters": {
              "status": "SUCCEEDED",
              "result.$": "$.verification.Payload"
            },
            "End": true
          },
          "MarkPlannedFailed": {
            "Type": "Pass",
            "Parameters": {
              "status": "FAILED",
              "error.$": "$.error"
            },
            "End": true
          },
          "RollingVerificationFailed": {
            "Type": "Pass",
            "Parameters": {
              "status": "FAILED",
              "error": {
                "Error": "RollingReconciliationVerificationFailed",
                "Cause": "Stale positions remain after rolling replay."
              },
              "result.$": "$.verification.Payload"
            },
            "End": true
          },
          "UnexpectedRollingVerificationResult": {
            "Type": "Pass",
            "Parameters": {
              "status": "FAILED",
              "error": {
                "Error": "UnexpectedRollingVerificationResult",
                "Cause": "The planner returned an unexpected rolling verification status."
              }
            },
            "End": true
          },
%{ endif }
          "MergeInto${table_name}": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "ResultPath": "$.merge_result",
            "Parameters": {
              "FunctionName": "${merge_function_name}",
              "Payload": {
                "resource": "/request/",
                "path": "/request/",
                "httpMethod": "POST",
                "headers": {
                  "Content-Type": "application/json"
                },
                "multiValueHeaders": {},
                "queryStringParameters": null,
                "requestContext": {
                  "resourcePath": "/request/",
                  "httpMethod": "POST",
                  "path": "/request/",
                  "identity": {
                    "sourceIp": "127.0.0.1"
                  }
                },
                "isBase64Encoded": false,
                "body.$": "States.JsonToString($)"
              }
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "IntervalSeconds": 2,
                "BackoffRate": 2,
                "MaxAttempts": 2
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "MarkFailed"
              }
            ],
            "Next": "MarkSucceeded"
          },
          "MarkSucceeded": {
            "Type": "Pass",
            "Parameters": {
              "filter_date.$": "$.filter_date",
              "status": "SUCCEEDED",
              "result.$": "$.merge_result.Payload"
            },
            "End": true
          },
          "MarkFailed": {
            "Type": "Pass",
            "Parameters": {
              "filter_date.$": "$.filter_date",
              "status": "FAILED",
              "error.$": "$.error"
            },
            "End": true
          }
        }
      },
%{ if planner_function_name != "" && reconciliation_consumer != "" }
      "Next": "CheckProcessDatesCompletion"
%{ else }
      "End": true
%{ endif }
    }%{ if planner_function_name != "" && reconciliation_consumer != "" },
    "CheckProcessDatesCompletion": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.mode",
          "StringEquals": "rolling",
          "Next": "CompleteRolling"
        }
      ],
      "Default": "MergeComplete"
    },
    "CompleteRolling": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${planner_function_name}",
        "Payload": {
          "action": "complete_rolling",
          "consumer": "${reconciliation_consumer}",
          "execution_id.$": "$.execution_id",
          "thread_id.$": "$.thread_id",
          "episode_id.$": "$.episode_id",
          "results.$": "$.date_results"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "CheckRollingCompletion"
    },
    "CheckRollingCompletion": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.status",
          "StringEquals": "continue_rolling",
          "Next": "DiscoverRollingContinuation"
        },
        {
          "Variable": "$.status",
          "StringEquals": "continue_recovery",
          "Next": "DiscoverRollingRecoveryContinuation"
        },
        {
          "Variable": "$.status",
          "StringEquals": "continue_execution",
          "Next": "StartRecoveryContinuation"
        },
        {
          "Variable": "$.status",
          "StringEquals": "completed",
          "Next": "RollingComplete"
        },
        {
          "Variable": "$.status",
          "StringEquals": "failed",
          "Next": "RollingFailed"
        }
      ],
      "Default": "UnexpectedRollingCompletionResult"
    },
    "StartRecoveryContinuation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution",
      "Parameters": {
        "StateMachineArn.$": "$$.StateMachine.Id",
        "Name.$": "States.UUID()",
        "Input": {
          "mode": "rolling_recovery",
          "recovery_episode_id.$": "$.episode_id",
          "lease_token.$": "$.lease_token",
          "AWS_STEP_FUNCTIONS_STARTED_BY_EXECUTION_ID.$": "$$.Execution.Id"
        }
      },
      "ResultPath": "$.continuation",
      "Next": "RollingComplete"
    },
    "RollingComplete": {
      "Type": "Succeed"
    },
    "RollingFailed": {
      "Type": "Fail",
      "Error": "RollingReconciliationFailed",
      "Cause": "One or more rolling replay work items failed."
    },
    "UnexpectedRollingCompletionResult": {
      "Type": "Fail",
      "Error": "UnexpectedRollingCompletionResult",
      "Cause": "The planner returned an unexpected rolling completion status."
    },
    "MergeComplete": {
      "Type": "Succeed"
    }
%{ endif }
  }
}
