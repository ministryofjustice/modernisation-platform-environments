---
apiVersion: v1
kind: Config
preferences: {}

current-context: data-platform

clusters:
  - name: data-platform
    cluster:
      certificate-authority-data: ${cluster_certificate_authority_data}
      server: ${cluster_server}

users:
  - name: data-platform
    user:
      exec:
        apiVersion: client.authentication.k8s.io/v1
        command: aws
        args:
          - "eks"
          - "get-token"
          - "--cluster-name"
          - "${cluster_name}"
          - "--region"
          - "eu-west-2"

contexts:
  - name: data-platform
    context:
      cluster: data-platform
      user: data-platform
