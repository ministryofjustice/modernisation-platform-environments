---
txtOwnerId: ${txt_owner_id}

%{ if enable_compatibility_settings ~}
# Chart 1.23.0+ requires an explicit policy; keep the previous default
policy: upsert-only

# ExternalDNS 0.22+ defaults to external-dns.kubernetes.io/ with no fallback;
# keep the alpha prefix used by the shared services Gateway annotations
annotationPrefix: external-dns.alpha.kubernetes.io/

%{ endif ~}
sources:
  - service
  - ingress
  - gateway-httproute

domainFilters:
%{ for domain_filter in domain_filters ~}
  - ${domain_filter}
%{ endfor ~}

serviceAccount:
  annotations:
    eks.amazonaws.com/role-arn: ${eks_role_arn}

nodeSelector:
  compute.data-platform.service.justice.gov.uk/node: system

tolerations:
  - key: compute.data-platform.service.justice.gov.uk/node
    operator: Equal
    value: system
    effect: NoSchedule

serviceMonitor:
  enabled: true
