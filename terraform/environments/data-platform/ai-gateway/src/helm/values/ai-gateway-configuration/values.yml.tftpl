---
hostname: ${hostname}
adminHostname: ${admin_hostname}
internalHostname: ${internal_hostname}
guardrailDiagnosticsEnabled: ${guardrail_diagnostics_enabled}
guardrailDiagnosticsHostname: ${guardrail_diagnostics_hostname}
certificateArn: ${certificate_arn}
albLogsBucket: ${alb_logs_bucket}
idleTimeoutSeconds: ${idle_timeout_seconds}
