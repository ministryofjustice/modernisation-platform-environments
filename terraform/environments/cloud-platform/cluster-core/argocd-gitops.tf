###############################################################################
# ArgoCD GitOps — AppProjects and ApplicationSets (ADR-002, ADR-015, US-015b)
#
# Deploys ArgoCD control plane resources (Level 1) on the hub cluster:
# - Per-BU AppProjects with sourceRepos and destination restrictions
# - Platform AppProject for infrastructure add-ons and namespace baselines
# - Per-BU ApplicationSets using git-directory-generator (workloads)
# - Per-BU baseline ApplicationSets using git-file-generator (product.yaml)
#
# Only created when the cluster has the argocd-role=hub tag (set by the
# cluster component when enable_argocd=true).
#
# References:
#   - ADR-002: AppProject Hierarchy and BU Isolation Guardrails
#   - ADR-015: Shared Monorepo with Product-Based Structure (amended)
#   - US-015b: Spoke Registration and GitOps Configuration
#   - product-onboarding-tier2-design.md: Tier 2 design document
###############################################################################

# ArgoCD GitOps locals (is_argocd_hub, argocd_codeconnection_*, environments_repo*,
# bu_configs, bu_appprojects, hub_tier, is_ephemeral_hub, hub_bu_appprojects,
# ephemeral_spoke_registration, hub_registered_spokes) are defined in locals.tf,
# matching the house convention that resource files carry no locals. The
# CodeConnection data source they depend on lives in data.tf.

#------------------------------------------------------------------------------
# Platform AppProject — deploys infrastructure add-ons to all spoke clusters
#------------------------------------------------------------------------------
resource "kubectl_manifest" "argocd_project_platform_nonlive" {
  count = local.is_argocd_hub && local.hub_tier == "nonlive" ? 1 : 0

  yaml_body = yamlencode({
    apiVersion = "argoproj.io/v1alpha1"
    kind       = "AppProject"
    metadata = {
      name      = "platform-nonlive"
      namespace = "argocd"
    }
    spec = {
      description = "Platform infrastructure add-ons deployed to all non-live spoke clusters"
      # Applications are generated by the ApplicationSets into the argocd
      # namespace (apps-in-any-namespace). Each project must permit that source
      # namespace or ArgoCD rejects the project binding on sync.
      sourceNamespaces = ["argocd"]
      sourceRepos = [
        local.environments_repo,
        "${local.environments_repo}.git",
      ]
      # Destinations restricted to the spokes this hub owns (its own tier, or
      # the paired ephemeral spoke on a dev hub).
      destinations = [
        for key, spoke in local.hub_registered_spokes : {
          server    = spoke.cluster_arn
          namespace = "*"
        }
      ]
      clusterResourceWhitelist = [
        { group = "*", kind = "Namespace" },
        { group = "rbac.authorization.k8s.io", kind = "ClusterRole" },
        { group = "rbac.authorization.k8s.io", kind = "ClusterRoleBinding" },
        { group = "admissionregistration.k8s.io", kind = "*" },
        { group = "apiextensions.k8s.io", kind = "CustomResourceDefinition" },
      ]
      namespaceResourceWhitelist = [
        { group = "*", kind = "*" }
      ]
    }
  })
}

resource "kubectl_manifest" "argocd_project_platform_live" {
  count = local.is_argocd_hub && local.hub_tier == "live" ? 1 : 0

  yaml_body = yamlencode({
    apiVersion = "argoproj.io/v1alpha1"
    kind       = "AppProject"
    metadata = {
      name      = "platform-live"
      namespace = "argocd"
    }
    spec = {
      description = "Platform infrastructure add-ons deployed to all live spoke clusters"
      # See platform-nonlive: generated Applications live in the argocd
      # namespace, so it must be an allowed source namespace for this project.
      sourceNamespaces = ["argocd"]
      sourceRepos = [
        local.environments_repo,
        "${local.environments_repo}.git",
      ]
      # Destinations restricted to the spokes this hub owns (its own tier).
      destinations = [
        for key, spoke in local.hub_registered_spokes : {
          server    = spoke.cluster_arn
          namespace = "*"
        }
      ]
      clusterResourceWhitelist = [
        { group = "*", kind = "Namespace" },
        { group = "rbac.authorization.k8s.io", kind = "ClusterRole" },
        { group = "rbac.authorization.k8s.io", kind = "ClusterRoleBinding" },
        { group = "admissionregistration.k8s.io", kind = "*" },
        { group = "apiextensions.k8s.io", kind = "CustomResourceDefinition" },
      ]
      namespaceResourceWhitelist = [
        { group = "*", kind = "*" }
      ]
    }
  })
}


#------------------------------------------------------------------------------
# Bootstrap AppProjects for the per-product AppProject generator — the ONLY
# projects permitted to create AppProject resources. The argocd_appproject_products
# ApplicationSet runs its generated Applications under these, so creating an
# AppProject is scoped away from every BU/workload project. AppProjects are
# namespaced objects in the hub's argocd namespace, so the destination is the
# hub cluster and the grant is namespace-scoped (argoproj.io/AppProject only).
#------------------------------------------------------------------------------
resource "kubectl_manifest" "argocd_project_platform_appprojects_nonlive" {
  count = local.is_argocd_hub && local.hub_tier == "nonlive" ? 1 : 0

  yaml_body = yamlencode({
    apiVersion = "argoproj.io/v1alpha1"
    kind       = "AppProject"
    metadata = {
      name      = "platform-appprojects-nonlive"
      namespace = "argocd"
    }
    spec = {
      description = "Bootstrap project permitted to create per-product AppProjects on the non-live hub"
      # Generated Applications live in the argocd namespace (apps-in-any-namespace).
      sourceNamespaces = ["argocd"]
      sourceRepos = [
        local.environments_repo,
        "${local.environments_repo}.git",
      ]
      # AppProjects are created in the hub's own argocd namespace.
      destinations = [
        {
          server    = local.hub_cluster_arn
          namespace = "argocd"
        }
      ]
      # This project may only create AppProjects — nothing else.
      namespaceResourceWhitelist = [
        { group = "argoproj.io", kind = "AppProject" }
      ]
      clusterResourceBlacklist = [
        { group = "*", kind = "Namespace" },
        { group = "rbac.authorization.k8s.io", kind = "ClusterRole" },
        { group = "rbac.authorization.k8s.io", kind = "ClusterRoleBinding" },
        { group = "apiextensions.k8s.io", kind = "CustomResourceDefinition" },
      ]
    }
  })
}

resource "kubectl_manifest" "argocd_project_platform_appprojects_live" {
  count = local.is_argocd_hub && local.hub_tier == "live" ? 1 : 0

  yaml_body = yamlencode({
    apiVersion = "argoproj.io/v1alpha1"
    kind       = "AppProject"
    metadata = {
      name      = "platform-appprojects-live"
      namespace = "argocd"
    }
    spec = {
      description = "Bootstrap project permitted to create per-product AppProjects on the live hub"
      # Generated Applications live in the argocd namespace (apps-in-any-namespace).
      sourceNamespaces = ["argocd"]
      sourceRepos = [
        local.environments_repo,
        "${local.environments_repo}.git",
      ]
      # AppProjects are created in the hub's own argocd namespace.
      destinations = [
        {
          server    = local.hub_cluster_arn
          namespace = "argocd"
        }
      ]
      # This project may only create AppProjects — nothing else.
      namespaceResourceWhitelist = [
        { group = "argoproj.io", kind = "AppProject" }
      ]
      clusterResourceBlacklist = [
        { group = "*", kind = "Namespace" },
        { group = "rbac.authorization.k8s.io", kind = "ClusterRole" },
        { group = "rbac.authorization.k8s.io", kind = "ClusterRoleBinding" },
        { group = "apiextensions.k8s.io", kind = "CustomResourceDefinition" },
      ]
    }
  })
}


#------------------------------------------------------------------------------
# Per-BU AppProjects — isolates each BU's workloads to their own cluster and repos
#------------------------------------------------------------------------------
resource "kubectl_manifest" "argocd_project_bu" {
  for_each = local.is_argocd_hub ? local.hub_registered_spokes : {}

  yaml_body = yamlencode({
    apiVersion = "argoproj.io/v1alpha1"
    kind       = "AppProject"
    metadata = {
      name      = each.key
      namespace = "argocd"
      labels = {
        "argocd.argoproj.io/managed-by"  = "terraform"
        "container-platform/bu"          = each.value.bu_name
        "container-platform/environment" = each.value.environment
      }
    }
    spec = {
      description = "Workload deployments for ${upper(each.value.bu_name)} ${each.value.environment}"
      # Generated Applications live in the argocd namespace (apps-in-any-namespace),
      # so the project must permit argocd as a source namespace.
      sourceNamespaces = ["argocd"]
      sourceRepos = [
        each.value.source_repo,
        "${each.value.source_repo}.git",
      ]
      # Workloads moved to the per-product AppProjects (<bu>-<product>-<env>),
      # which bound each workload to its product's declared namespaces. This
      # project no longer hosts workload Applications; it is retained only for
      # the bu-viewer read-only role below. A no-op destination (argocd, not
      # "*") keeps destinations non-empty without granting any workload scope —
      # the namespaceResourceWhitelist still limits what could ever be created.
      destinations = [
        {
          server    = each.value.cluster_arn
          namespace = "argocd"
        }
      ]
      # BU workload projects can only create workload-level resources
      namespaceResourceWhitelist = [
        { group = "", kind = "ConfigMap" },
        { group = "", kind = "Secret" },
        { group = "", kind = "Service" },
        { group = "", kind = "ServiceAccount" },
        { group = "", kind = "PersistentVolumeClaim" },
        { group = "apps", kind = "Deployment" },
        { group = "apps", kind = "StatefulSet" },
        { group = "apps", kind = "DaemonSet" },
        { group = "apps", kind = "ReplicaSet" },
        { group = "batch", kind = "Job" },
        { group = "batch", kind = "CronJob" },
        { group = "autoscaling", kind = "HorizontalPodAutoscaler" },
        { group = "policy", kind = "PodDisruptionBudget" },
        { group = "networking.k8s.io", kind = "Ingress" },
        { group = "networking.k8s.io", kind = "NetworkPolicy" },
        { group = "gateway.networking.k8s.io", kind = "HTTPRoute" },
        { group = "gateway.networking.k8s.io", kind = "GRPCRoute" },
        { group = "gateway.networking.k8s.io", kind = "ListenerSet" },
        { group = "gateway.envoyproxy.io", kind = "EnvoyExtensionPolicy" },
      ]
      # BU projects cannot create cluster-scoped resources
      clusterResourceBlacklist = [
        { group = "*", kind = "Namespace" },
        { group = "rbac.authorization.k8s.io", kind = "ClusterRole" },
        { group = "rbac.authorization.k8s.io", kind = "ClusterRoleBinding" },
        { group = "apiextensions.k8s.io", kind = "CustomResourceDefinition" },
      ]
      # Read-only project role (layer 2 of the BU-user access model — ADR-002,
      # cloud-platform#8548). Global VIEWER (layer 1, cluster component) only
      # grants UI login; a project role is what actually makes this BU's
      # Applications visible, and scopes that visibility to this project alone.
      # Bound to the BU's parent IAM Identity Center group. `clusters, get`
      # lets the UI show the destination cluster name instead of "unknown".
      # Omitted when the group did not resolve or there is no BU group
      # (ephemeral dev spokes) — an empty list yields no role.
      roles = each.value.viewer_group_id == null ? [] : [
        {
          name        = "bu-viewer"
          description = "Read-only Application access for ${upper(each.value.bu_name)} (${each.value.environment})"
          # Workload Applications now live under the per-product projects
          # (<bu>-<product>-<env>), so the applications grant widens from this
          # project to all of this BU's per-product projects for the tier. The
          # glob is built from bu_name + environment (octo-*-nonlive/*), NOT
          # each.key (which already is <bu>-<env> and would wrongly yield
          # <bu>-<env>-*/*). The clusters,get line is kept verbatim.
          policies = [
            "p, proj:${each.key}:bu-viewer, applications, get, ${each.value.bu_name}-*-${each.value.environment}/*, allow",
            "p, proj:${each.key}:bu-viewer, clusters, get, *, allow",
          ]
          groups = [each.value.viewer_group_id]
        }
      ]
    }
  })
}


#------------------------------------------------------------------------------
# Per-BU Workload ApplicationSets — git-file-generator creates Applications
# automatically when new values files appear in the monorepo.
# Path: namespaces/<bu>/<product>/<service>/deployment/values/<tier>/<env>.yaml
# Segments: [namespaces, bu, product, service, deployment, values, tier]
#------------------------------------------------------------------------------
resource "kubectl_manifest" "argocd_applicationset_bu" {
  for_each = local.is_argocd_hub ? local.hub_registered_spokes : {}

  yaml_body = yamlencode({
    apiVersion = "argoproj.io/v1alpha1"
    kind       = "ApplicationSet"
    metadata = {
      name      = "${each.key}-apps"
      namespace = "argocd"
      labels = {
        "argocd.argoproj.io/managed-by"  = "terraform"
        "container-platform/bu"          = each.value.bu_name
        "container-platform/environment" = each.value.environment
        "container-platform/type"        = "workload"
      }
    }
    spec = {
      goTemplate        = true
      goTemplateOptions = ["missingkey=error"]
      generators = [
        {
          git = {
            repoURL  = each.value.source_repo
            revision = "main"
            # One values file per (service, environment) on this cluster tier.
            # File path: namespaces/<bu>/<product>/<service>/deployment/values/<tier>/<env>.yaml
            files = [
              { path = "${each.value.path_prefix}/*/*/deployment/values/${each.value.environment}/*.yaml" }
            ]
          }
        }
      ]
      template = {
        metadata = {
          # dir segments: [namespaces, bu, product, service, deployment, values, tier]
          # filename: <env>.yaml (dev|staging|prod)
          name = "${each.value.bu_name}-{{ index .path.segments 3 }}-{{ trimSuffix \".yaml\" .path.filename }}"
          labels = {
            "container-platform/bu"          = each.value.bu_name
            "container-platform/environment" = "{{ trimSuffix \".yaml\" .path.filename }}"
            "container-platform/product"     = "{{ index .path.segments 2 }}"
            "container-platform/app"         = "{{ index .path.segments 3 }}"
          }
        }
        spec = {
          # Per-product AppProject (<bu>-<productDir>-<env>). The product segment
          # is index .path.segments 2 — the same product directory the
          # argocd_appproject_products generator uses for productDir, so the
          # reference and the generated project name share one source and cannot
          # diverge. The per-product project's destinations bound the free-form
          # destination.namespace below to this product's declared namespaces.
          project = "${each.value.bu_name}-{{ index .path.segments 2 }}-${each.value.environment}"
          source = {
            repoURL        = each.value.source_repo
            targetRevision = "main"
            # Chart dir is the values file's directory minus /values/<tier>
            path = "{{ trimSuffix \"/values/${each.value.environment}\" .path.path }}"
            helm = {
              valueFiles = ["values/${each.value.environment}/{{ .path.filename }}"]
            }
          }
          destination = {
            server = each.value.cluster_arn
            # Namespace comes from the routing key inside the values file
            namespace = "{{ .namespace }}"
          }
          syncPolicy = each.value.auto_sync ? {
            automated = {
              prune    = true
              selfHeal = true
            }
            syncOptions = [
              "CreateNamespace=false",
              "PrunePropagationPolicy=foreground",
            ]
            } : {
            automated = null
            syncOptions = [
              "CreateNamespace=false",
            ]
          }
        }
      }
    }
  })

  # Manifest-apply ordering only: ensures the per-product AppProject generator
  # and the per-BU project manifests are applied before this ApplicationSet.
  # It does NOT order ArgoCD runtime reconciliation — the first-sync window
  # (workload Application reconciling before its per-product project exists)
  # self-heals via auto-sync, not depends_on.
  depends_on = [
    kubectl_manifest.argocd_project_bu,
    kubectl_manifest.argocd_appproject_products,
  ]
}


#------------------------------------------------------------------------------
# Per-product AppProject generator — git-file-generator reads each product.yaml
# and renders charts/appproject-per-product to create one AppProject per
# product/tier, scoped to that product's declared namespaces. Runs under the
# platform-appprojects-<env> bootstrap project (the only project allowed to
# create AppProjects). Mirrors the baseline ApplicationSet wiring.
#------------------------------------------------------------------------------
resource "kubectl_manifest" "argocd_appproject_products" {
  for_each = local.is_argocd_hub ? local.hub_registered_spokes : {}

  yaml_body = yamlencode({
    apiVersion = "argoproj.io/v1alpha1"
    kind       = "ApplicationSet"
    metadata = {
      name      = "${each.key}-appprojects"
      namespace = "argocd"
      labels = {
        "argocd.argoproj.io/managed-by"  = "terraform"
        "container-platform/bu"          = each.value.bu_name
        "container-platform/environment" = each.value.environment
        "container-platform/type"        = "appproject"
      }
    }
    spec = {
      goTemplate        = true
      goTemplateOptions = ["missingkey=error"]
      generators = [
        {
          git = {
            repoURL  = each.value.source_repo
            revision = "main"
            files = [
              { path = "${each.value.path_prefix}/*/product.yaml" }
            ]
          }
        }
      ]
      template = {
        metadata = {
          # Named from the product directory segment, matching the project it
          # produces (<bu>-<productDir>-<env>).
          name = "appproject-${each.value.bu_name}-{{ index .path.segments 2 }}-${each.value.environment}"
          labels = {
            "container-platform/bu"          = each.value.bu_name
            "container-platform/environment" = each.value.environment
            "container-platform/type"        = "appproject"
            "container-platform/product"     = "{{ index .path.segments 2 }}"
          }
        }
        spec = {
          project = "platform-appprojects-${each.value.environment}"
          source = {
            repoURL        = each.value.source_repo
            targetRevision = "main"
            path           = "charts/appproject-per-product"
            helm = {
              # product.yaml delivered as a valueFile (not valuesObject) exactly
              # like the baseline ApplicationSet; scalars drive name/scope.
              valueFiles = [
                "../../${each.value.path_prefix}/{{ index .path.segments 2 }}/product.yaml"
              ]
              parameters = [
                { name = "targetCluster", value = each.value.cluster_workspace },
                { name = "productDir", value = "{{ index .path.segments 2 }}" },
                { name = "bu", value = each.value.bu_name },
                { name = "environment", value = each.value.environment },
                { name = "server", value = each.value.cluster_arn },
                { name = "sourceRepo", value = each.value.source_repo },
              ]
            }
          }
          destination = {
            server    = each.value.cluster_arn
            namespace = "argocd"
          }
          syncPolicy = {
            automated = {
              prune    = true
              selfHeal = true
            }
            syncOptions = [
              "CreateNamespace=false",
              "ServerSideApply=true",
            ]
          }
        }
      }
    }
  })

  depends_on = [
    kubectl_manifest.argocd_project_platform_appprojects_nonlive,
    kubectl_manifest.argocd_project_platform_appprojects_live,
  ]
}


#------------------------------------------------------------------------------
# Per-BU Baseline ApplicationSets — git-file-generator reads product.yaml
# and renders the app-baseline Helm chart to create Namespace + RoleBinding +
# default-deny NetworkPolicy for each environment on this cluster tier.
#
# Runs under the platform-<env> AppProject (can create Namespaces).
# Always auto-syncs with self-heal to enforce baseline compliance.
#------------------------------------------------------------------------------
resource "kubectl_manifest" "argocd_applicationset_baseline" {
  for_each = local.is_argocd_hub ? local.hub_registered_spokes : {}

  yaml_body = yamlencode({
    apiVersion = "argoproj.io/v1alpha1"
    kind       = "ApplicationSet"
    metadata = {
      name      = "${each.key}-baselines"
      namespace = "argocd"
      labels = {
        "argocd.argoproj.io/managed-by"  = "terraform"
        "container-platform/bu"          = each.value.bu_name
        "container-platform/environment" = each.value.environment
        "container-platform/type"        = "baseline"
      }
    }
    spec = {
      goTemplate        = true
      goTemplateOptions = ["missingkey=error"]
      generators = [
        {
          git = {
            repoURL  = each.value.source_repo
            revision = "main"
            files = [
              { path = "${each.value.path_prefix}/*/product.yaml" }
            ]
          }
        }
      ]
      template = {
        metadata = {
          name = "baseline-${each.value.bu_name}-{{ .product }}-${each.value.environment}"
          labels = {
            "container-platform/bu"          = each.value.bu_name
            "container-platform/environment" = each.value.environment
            "container-platform/type"        = "baseline"
            "container-platform/product"     = "{{ .product }}"
          }
        }
        spec = {
          project = "platform-${each.value.environment}"
          source = {
            repoURL        = each.value.source_repo
            targetRevision = "main"
            path           = "charts/app-baseline"
            helm = {
              valueFiles = [
                "../../${each.value.path_prefix}/{{ .product }}/product.yaml"
              ]
              parameters = [
                {
                  name  = "targetCluster"
                  value = each.value.cluster_workspace
                }
              ]
            }
          }
          destination = {
            server    = each.value.cluster_arn
            namespace = "default"
          }
          syncPolicy = {
            automated = {
              prune    = true
              selfHeal = true
            }
            syncOptions = [
              "CreateNamespace=false",
              "ServerSideApply=true",
            ]
          }
        }
      }
    }
  })

  depends_on = [
    kubectl_manifest.argocd_project_platform_nonlive,
    kubectl_manifest.argocd_project_platform_live,
  ]
}

#------------------------------------------------------------------------------
# Spoke cluster registration Secrets — required for Argo CD to treat each
# spoke as a deployment target. Without this Secret, Applications targeting
# the spoke's cluster ARN sit in "Unknown" sync state indefinitely: Argo CD
# never attempts to connect until the cluster is registered.
#
# Minimal form only — name + server (the spoke's EKS cluster ARN). No
# config / awsAuthConfig / roleARN block: the EKS-managed Argo CD capability
# authenticates to spoke clusters natively as the hub's capability role (see
# cluster/argocd.tf — aws_eks_access_entry.argocd_spoke_capability), the same
# principal an awsAuthConfig roleARN would otherwise name. That block is only
# needed for self-managed Argo CD assuming a separate cross-account role,
# which this platform does not use.
#------------------------------------------------------------------------------
resource "kubectl_manifest" "argocd_cluster_secret_bu" {
  for_each = local.is_argocd_hub ? local.hub_registered_spokes : {}

  yaml_body = yamlencode({
    apiVersion = "v1"
    kind       = "Secret"
    metadata = {
      name      = each.value.cluster_workspace
      namespace = "argocd"
      labels = {
        "argocd.argoproj.io/secret-type" = "cluster"
        "argocd.argoproj.io/managed-by"  = "terraform"
        "container-platform/bu"          = each.value.bu_name
        "container-platform/environment" = each.value.environment
      }
    }
    type = "Opaque"
    stringData = {
      name   = each.value.cluster_workspace
      server = each.value.cluster_arn
    }
  })
}
