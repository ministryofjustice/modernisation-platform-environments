{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "FileActionExecutionRequested.v1",
  "description": "A routed object has matched a file action configuration. Non-secret routing information identifies the requested action and notification types, while sensitive values remain in Secrets Manager.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "detail-type",
    "source",
    "account",
    "time",
    "region",
    "detail"
  ],
  "properties": {
    "version": { "type": "string", "enum": ["0"] },
    "id": { "type": "string", "format": "uuid" },
    "detail-type": {
      "type": "string",
      "enum": ["FileActionExecutionRequested.v1"]
    },
    "source": {
      "type": "string",
      "enum": ["uk.gov.justice.service.managed-file-transfer"]
    },
    "account": { "type": "string", "pattern": "^[0-9]{12}$" },
    "time": { "type": "string", "format": "date-time" },
    "region": { "type": "string" },
    "resources": { "type": "array", "items": { "type": "string" } },
    "replay-name": { "type": "string", "minLength": 1 },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metadata", "data"],
      "properties": {
        "metadata": { "$ref": "#/definitions/eventMetadata" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fileId",
            "object",
            "actionExecutionId",
            "requestedAt",
            "notifications",
            "configurationReference"
          ],
          "anyOf": [
            { "required": ["action"] },
            {
              "properties": {
                "notifications": { "minItems": 1 }
              }
            }
          ],
          "properties": {
            "fileId": {
              "type": "string",
              "format": "uuid",
              "description": "Stable logical file identifier inherited from FileReceived.v1."
            },
            "object": { "$ref": "#/definitions/s3Object" },
            "action": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "minLength": 1 }
              }
            },
            "actionExecutionId": { "type": "string", "format": "uuid" },
            "requestedAt": { "type": "string", "format": "date-time" },
            "notifications": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "configurationReference": {
              "type": "object",
              "additionalProperties": false,
              "description": "Immutable reference to the sensitive action and notification configuration in Secrets Manager.",
              "required": ["secretArn", "secretVersionId"],
              "properties": {
                "secretArn": {
                  "type": "string",
                  "pattern": "^arn:aws[a-zA-Z-]*:secretsmanager:[a-z0-9-]+:[0-9]{12}:secret:.+$"
                },
                "secretVersionId": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "eventMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correlationId", "causationId", "idempotencyKey"],
      "properties": {
        "correlationId": { "type": "string", "format": "uuid" },
        "causationId": { "type": "string", "format": "uuid" },
        "idempotencyKey": { "type": "string", "minLength": 1 }
      }
    },
    "s3Object": {
      "type": "object",
      "additionalProperties": false,
      "description": "A particular version of an object stored in Amazon S3.",
      "required": ["bucket", "key", "versionId", "sizeBytes"],
      "properties": {
        "bucket": { "type": "string", "minLength": 3 },
        "key": { "type": "string", "minLength": 1 },
        "versionId": { "type": "string", "minLength": 1 },
        "sizeBytes": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "examples": [
    {
      "version": "0",
      "id": "2bd32cbb-c3e2-4b62-8b53-90ea0a7a4de5",
      "detail-type": "FileActionExecutionRequested.v1",
      "source": "uk.gov.justice.service.managed-file-transfer",
      "account": "123456789012",
      "time": "2026-07-10T14:04:00Z",
      "region": "eu-west-2",
      "detail": {
        "metadata": {
          "correlationId": "7d9f4e4c-0e0f-4a5b-8b4e-4ab1f28fd1d1",
          "causationId": "aa88e95a-159c-40c1-9e7b-38d00b0b6169",
          "idempotencyKey": "action-request:b1d4e7c2-f073-4ed4-9565-a4c31c54bd7f"
        },
        "data": {
          "fileId": "3f4e3d7a-4e2f-4bc2-9c4e-5f1ef2d4c501",
          "object": {
            "bucket": "clean",
            "key": "example/report.csv",
            "versionId": "5Ni...",
            "sizeBytes": 4096
          },
          "action": {
            "name": "place-on-sqs"
          },
          "actionExecutionId": "b1d4e7c2-f073-4ed4-9565-a4c31c54bd7f",
          "requestedAt": "2026-07-10T14:04:00Z",
          "notifications": ["email", "teams"],
          "configurationReference": {
            "secretArn": "arn:aws:secretsmanager:eu-west-2:123456789012:secret:integration-hub-file-transfer/file-dispatch/example-AbCdEf",
            "secretVersionId": "EXAMPLE1-90ab-cdef-fedc-ba9876543210"
          }
        }
      }
    }
  ]
}
