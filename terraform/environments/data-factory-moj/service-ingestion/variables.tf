variable "deployment" {
  description = "Prepared development inputs generated by the ingestion preparation process."

  type = object({
    environment     = string
    account_id      = string
    region          = string
    compiler_commit = string

    compiled_artifacts = any

    artifact = object({
      bucket_name      = string
      object_key       = string
      version_id       = string
      source_code_hash = string
    })

    registry = object({
      table_name = string
      table_arn  = string
    })

    runtime_settings = map(object({
      published_documents = object({
        bucket_name  = string
        prefix       = string
        bucket_owner = string
        kms_key_arns = optional(set(string), [])
      })

      source_credentials = object({
        mode              = string
        sync_function_arn = optional(string)
      })
    }))

    replication_capacities = map(object({
      vpc_id                         = string
      replication_instance_arn       = string
      replication_instance_id        = string
      replication_security_group_id  = string
      replication_security_group_ids = list(string)
      replication_subnet_group_id    = string

      task_log_group = optional(object({
        arn  = string
        name = string
      }))
    }))

    capacity_assignments = map(map(string))
  })

  default  = null
  nullable = true

  validation {
    condition = var.deployment == null ? !local.is-development : try(
      local.is-development &&
      terraform.workspace == "data-factory-moj-development" &&
      var.deployment.environment == "development" &&
      var.deployment.region == "eu-west-2" &&
      data.aws_region.current.region == var.deployment.region &&
      can(regex("^[0-9]{12}$", var.deployment.account_id)) &&
      var.deployment.account_id == data.aws_caller_identity.current.account_id &&
      var.deployment.account_id == local.environment_management.account_ids[terraform.workspace] &&
      can(regex("^[a-f0-9]{40}$", var.deployment.compiler_commit)) &&
      length(var.deployment.compiled_artifacts) > 0,
      false
    )

    error_message = "Supply prepared inputs for the authorised development account in eu-west-2. Inputs are required in development and must be omitted in every other environment."
  }
}
